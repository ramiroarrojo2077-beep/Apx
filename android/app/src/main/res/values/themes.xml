<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TemaRama" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:statusBarColor">@color/fondo</item>
        <item name="android:navigationBarColor">@color/fondo</item>
        <item name="android:colorAccent">@color/acento</item>
        <item name="android:colorControlActivated">@color/acento</item>
        <item name="android:textColorHighlight">@color/seleccion</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- Sin la animación de zoom del sistema: abre y cierra sin sacudones. -->
        <item name="android:windowAnimationStyle">@android:style/Animation.Translucent</item>
    </style>
</resources>
